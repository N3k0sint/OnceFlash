# OnceFlash — Environment Configuration Template
# Copy this file to .env for local development.
# For Vercel hosting, configure these variables in: Project Settings -> Environment Variables.

# ── Storage Configuration ───────────────────────────────────────────────────────
# Local default: Uses thread-safe in-memory ephemeral store (Zero setup required).
REDIS_URL=memory://

# For Vercel Cloud Hosting (Serverless Multi-Instance):
# Connect an Upstash Redis database (Free via Vercel Marketplace or upstash.com):
# UPSTASH_REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379
# (Or set REDIS_URL to your rediss:// connection string)

# ── CORS & Security ─────────────────────────────────────────────────────────────
# Set to your production domain or Vercel URL, e.g.:
# ALLOWED_ORIGINS=https://onceflash.vercel.app
ALLOWED_ORIGINS=*

# ── Rate Limits ─────────────────────────────────────────────────────────────────
# Maximum requests per minute per IP address
RATE_LIMIT_CREATE=20/minute
RATE_LIMIT_READ=60/minute

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
